# Local development only. Copy to backend/.env. On Render, set these in the dashboard instead.
# NEVER commit the real .env file (it is in .gitignore).
OPENROUTER_API_KEY=sk-or-REPLACE-ME
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Origins allowed to call the API (comma separated). Add your Vercel address in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional, to allow Vercel preview deployments:
# ALLOWED_ORIGIN_REGEX=https://docuverify-.*\.vercel\.app

# Optional login (works when the backend serves the page itself, not across Vercel -> Render)
# APP_USER=docuverify
# APP_PASSWORD=
